{
  "name": "dusk-vault",
  "tree": {
    "$className": "DataModel",
    "Players": {
      "$properties": {
        "CharacterAutoLoads": false
      }
    },
    "ReplicatedStorage": {
      "Remotes": {
        "$className": "Folder",
        "Intent": {
          "$className": "RemoteEvent"
        },
        "Snapshot": {
          "$className": "RemoteEvent"
        }
      }
    },
    "ServerStorage": {
      "BestScore": {
        "$path": "src/BestScore.luau"
      },
      "Enemies": {
        "$path": "src/Enemies.luau"
      },
      "Levels": {
        "$path": "src/Levels.luau"
      },
      "Rules": {
        "$path": "src/Rules.luau"
      },
      "Tools": {
        "$path": "src/Tools.luau"
      }
    },
    "ServerScriptService": {
      "Sessions": {
        "$path": "src/Sessions.server.luau"
      }
    },
    "ReplicatedFirst": {
      "Client": {
        "$path": "src/Client.client.luau"
      }
    },
    "StarterGui": {
      "Board": {
        "$path": "src/Board.luau"
      },
      "Draw": {
        "$path": "src/Draw.luau"
      },
      "Hud": {
        "$path": "src/Hud.luau"
      },
      "Screens": {
        "$path": "src/Screens.luau"
      }
    },
    "Workspace": {
      "$properties": {
        "FilteringEnabled": true
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
